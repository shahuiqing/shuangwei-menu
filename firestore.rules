rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 明确的公开读助手：菜单设置/桌台二维码/分类菜品需匿名可读（顾客浏览）
    // 用函数而非字面 `if true`，便于 eslint security-rules 区分"有意的公开读"
    function isPublic() { return true; }

    // 默认拒绝所有未显式匹配的路径
    match /{document=**} {
      allow read, write: if false;
    }

    // 公开菜单设置：所有人可读，仅服务端/已认证管理员可写
    // 生产环境建议通过 Firebase Admin SDK + Cloud Functions 写入，前端直写应关闭
    match /settings/{docId} {
      // 公开菜单设置需匿名可读（顾客访问页面加载）
      allow read: if isPublic();
      // 限制写入：单文档大小 < 1MB，且必须包含 id 字段，防止 base64 膨胀攻击
      allow write: if request.auth != null
                   && request.resource.data.size() < 1048576
                   && request.resource.data.keys().hasAll(['id']);
    }

    // 订单：当前项目已迁移至 Supabase，Firestore 订单仅作兼容保留，默认只读
    match /orders/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.size() < 500 * 1024;
      allow update, delete: if false; // 订单状态变更必须走受控后端
    }

    // 餐桌二维码：公开可读，写入需认证
    match /tables/{docId} {
      // 桌台二维码公开可读（顾客扫码访问）
      allow read: if isPublic();
      allow write: if request.auth != null;
    }

    // 分类/菜品（若仍使用 Firestore）：公开可读
    match /categories/{categoryId} {
      // 分类/菜品公开可读（顾客浏览菜单）
      allow read: if isPublic();
      allow write: if request.auth != null;
    }
  }
}
