# ─── Supabase（数据库 + 登录验证） ───
# 浏览器端（VITE_* 会注入前端 bundle）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# 服务端 Pages 函数用（EdgeOne Pages 环境变量，勿放前端）
# 用于 functions/api/auth/verify.ts 读取 settings.adminPasswordHash 验密
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 管理员鉴权（生产必须设置）
ADMIN_SECRET=please_set_a_strong_random_secret

# ─── EdgeOne Pages（可选，若用 KV/Blob 持久化缓存） ───
# EdgeOne Pages 控制台配置 KV 绑定 my_kv（函数经 context.env.my_kv 访问）
# Blob 存储由 @edgeone/pages-blob 自动鉴权，无需配置

# ─── Cloudflare D1（旧版本地 json 模式，EdgeOne 部署无需） ───
CLOUDFLARE_API_TOKEN=your_cf_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id_here
CLOUDFLARE_D1_DB_ID=your_d1_database_id_here

# ─── 外部打印 Worker（可选） ───
# 安全提示：**留空即不外发**。此前存在硬编码默认地址会把订单（含顾客信息）发往第三方，已移除。
# 只有显式填写后订单才会 POST 到该地址；PRINT_WORKER_URL 同时是 /api/webhooks/orders 的开关，
# 未配置时该 webhook 端点返回 503（fail-closed），不会对公网开放。
PRINT_WORKER_URL=
PRINT_WORKER_TOKEN=
# 可选：限制外发主机白名单（逗号分隔的 host）。设置后仅放行列出的主机。
PRINT_WORKER_ALLOWLIST=

# ─── 反向代理 / 限流（可选） ───
# 默认 false：限流只认 TCP 对端 IP，忽略 x-forwarded-for（防伪造绕过）。
# 仅当服务部署在可信反代/边缘之后时设为 true，此时按 x-forwarded-for 最右侧地址限流。
TRUST_PROXY=false
